# Local development defaults. Never put credentials or document data here.
IDP_ENVIRONMENT=development
IDP_PLATFORM_PROFILE=local
IDP_AUTH_MODE=demo
IDP_DATABASE_URL=sqlite:///./var/idp.db
IDP_OBJECT_ROOT=./sample-data/uploads
IDP_DOCUMENT_TYPE_PATH=./config/document-types/medical-report.v1.json
# Insurance product catalogue for the Create case form (directory of *.json files, or one file).
# The shipped file is DEMO data; replace it with the insurer's approved catalogue.
IDP_PRODUCT_CATALOGUE_PATH=./config/products
# Underwriting rule set and optional risk-scoring model used by the case assessment.
# The shipped file is DEMO data; replace it with the insurer's approved rules. Remove the
# directory to turn rules off (recommendation and risk score then show Not Available).
IDP_UNDERWRITING_RULES_PATH=./config/underwriting
IDP_STORAGE_BACKEND=local
IDP_QUEUE_BACKEND=database
IDP_SCANNER_BACKEND=development-basic
IDP_MAX_UPLOAD_BYTES=52428800
IDP_MAX_PAGES=200
IDP_MAX_IMAGE_PIXELS=50000000
IDP_OCR_PROVIDER=none
# IDP_OCR_REGION=ap-south-1
IDP_EXTRACTION_PROVIDER=deterministic-local
IDP_ALLOWED_PROVIDERS=deterministic-local
IDP_SEED_DEMO_CASE=true
IDP_DEMO_CASE_IDS=Dummy-Dummy-29495
IDP_CORS_ORIGINS=http://localhost:5173

# Aadhaar / PAN official verification. Both default to not_configured, so nothing is ever reported
# as verified. Enable only with an authorized provider, signed agreements and recorded consent.
IDP_IDENTITY_AADHAAR_PROVIDER=not_configured
# IDP_IDENTITY_AADHAAR_PROVIDER=uidai-offline-qr
# IDP_IDENTITY_AADHAAR_TRUST_CERT_PATH=./config/trust/uidai-offline-signing.cer
IDP_IDENTITY_PAN_PROVIDER=not_configured
# IDP_IDENTITY_PAN_PROVIDER=http
# IDP_IDENTITY_PAN_ENDPOINT=https://authorized-pan-provider.example/verify
# IDP_IDENTITY_PAN_API_KEY=local-secret
# IDP_IDENTITY_PAN_TIMEOUT_SECONDS=10
# IDP_IDENTITY_PAN_MAX_RETRIES=2
# Scanned Aadhaar / PAN images need OCR. With IDP_OCR_PROVIDER=none they fail with ocr_unavailable.

# Required only for production OIDC mode.
# IDP_OIDC_ISSUER=https://identity.example.com/
# IDP_OIDC_AUDIENCE=medical-evidence-api
# IDP_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# IDP_TENANT_CLAIM=tenant_id
# IDP_ROLES_CLAIM=roles
# IDP_CASES_CLAIM=case_ids

# To enable external extraction, replace the deterministic-local provider settings above
# with ONE approved provider. Keep real credentials only in your ignored local .env file.
#
# OpenAI-compatible chat-completions endpoint:
# IDP_EXTRACTION_PROVIDER=openai-compatible
# IDP_EXTERNAL_PROVIDER_APPROVED=true
# IDP_ALLOWED_PROVIDERS=openai-compatible
# IDP_MODEL_ID=approved-model-id
# IDP_MODEL_ENDPOINT=https://approved-provider.example/v1/chat/completions
# IDP_MODEL_API_KEY=local-secret
#
# Or use the common OpenAI variable names instead of the three IDP_MODEL_* settings:
# OPENAI_BASE_URL=https://approved-provider.example/v1
# OPENAI_MODEL=approved-model-id
# OPENAI_API_KEY=local-secret
# OPENAI_FAST_MODEL is currently unused; extraction uses OPENAI_MODEL.
#
# Or Azure OpenAI:
# IDP_EXTRACTION_PROVIDER=azure-openai
# IDP_EXTERNAL_PROVIDER_APPROVED=true
# IDP_ALLOWED_PROVIDERS=azure-openai
# IDP_MODEL_ID=approved-deployment-name
# IDP_MODEL_ENDPOINT=https://approved-resource.openai.azure.com/openai/deployments/approved-deployment/chat/completions
# IDP_MODEL_API_VERSION=approved-pinned-api-version
# IDP_MODEL_API_KEY=local-secret
# IDP_MODEL_REGION=approved-azure-region
# IDP_APPROVED_PROVIDER_REGIONS=approved-azure-region


