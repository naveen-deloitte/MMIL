{
  "document_type": "medical_report",
  "schema_version": "1.0.0",
  "display_name": "Medical report",
  "constraints": {
    "media_types": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/tiff"
    ],
    "max_pages": 200
  },
  "fields": [
    {
      "path": "report.observed_date",
      "label": "Report date",
      "data_type": "date",
      "ui_section": "summary",
      "ui_group": "Report",
      "required": false,
      "citations_required": true,
      "patterns": [
        {
          "regex": "(?im)^[ \\t]*(?:Report|Examination|Observed)[ \\t]+Date[ \\t]*[:\\-][ \\t]*(?P<value>\\d{4}-\\d{2}-\\d{2}|\\d{1,2}[ /-][A-Za-z]{3,9}[ /-]\\d{4})[ \\t]*$"
        }
      ],
      "description": "Explicit Report date value as stated in the document.",
      "normalizers": [
        "trim"
      ],
      "validators": [
        "type"
      ]
    },
    {
      "path": "observations.height_cm",
      "label": "Height",
      "data_type": "decimal",
      "ui_section": "vitals",
      "ui_group": "Body measurements",
      "unit": "cm",
      "required": false,
      "citations_required": true,
      "patterns": [
        {
          "regex": "(?im)^[ \\t]*Height\\s*[:\\-]\\s*(?P<value>\\d{2,3}(?:\\.\\d+)?)[ \\t]*(?:cm|centimet(?:re|er)s?)[ \\t]*$"
        },
        {
          "regex": "(?im)^[ \\t]*Height[ \\t]*\\r?\\n[ \\t]*(?P<value>\\d{2,3}(?:\\.\\d+)?)[ \\t]*$"
        }
      ],
      "description": "Explicit Height value as stated in the document.",
      "normalizers": [
        "trim",
        "decimal"
      ],
      "validators": [
        "type"
      ]
    },
    {
