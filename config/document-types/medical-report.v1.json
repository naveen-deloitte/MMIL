      "label": "Weight",
      "data_type": "decimal",
      "ui_section": "vitals",
      "ui_group": "Body measurements",
      "unit": "kg",
      "required": false,
      "citations_required": true,
      "patterns": [
        {
          "regex": "(?im)^[ \\t]*Weight\\s*[:\\-]\\s*(?P<value>\\d{2,3}(?:\\.\\d+)?)[ \\t]*(?:kg|kilograms?)[ \\t]*$"
        },
        {
          "regex": "(?im)^[ \\t]*Weight[ \\t]*\\r?\\n[ \\t]*(?P<value>\\d{2,3}(?:\\.\\d+)?)[ \\t]*$"
